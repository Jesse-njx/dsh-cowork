{
  "name": "dsh-cowork",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Cowork \u2014 READ + WRITE for office documents and notebooks inside DeepSeek Harness (xlsx / pdf / docx / pptx / ipynb)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "publish:all": "node scripts/publish.mjs",
    "prepare": "pnpm -r build"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jesse-njx/dsh-cowork.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "documents",
    "office",
    "notebook"
  ]
